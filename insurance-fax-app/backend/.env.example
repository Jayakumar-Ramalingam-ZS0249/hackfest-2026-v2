# Copy this file to backend/.env and fill in real values.
# Everything here has a safe default (see app/core/config.py) except AI_API_KEY --
# without it the app falls back to the deterministic rule-based extractor and the
# AI Claim Assistant chat feature responds that it is not configured.

APP_ENV=development

# AI provider. "gemini" is the only implemented provider today; anything else
# (or a blank AI_API_KEY) makes the backend fall back to regex-based extraction
# with zero external calls, and disables the chat agent.
AI_PROVIDER=gemini
# "gemini-flash-latest" tracks Google's current recommended flash model --
# a dated model name (e.g. gemini-2.5-flash) can and does get retired for
# new API keys/projects, which breaks the AI Claim Assistant with a NotFound
# error until this is updated.
AI_MODEL=gemini-flash-latest
AI_API_KEY=

# Upload limits
MAX_FILE_SIZE_MB=10

# Document relevance thresholds (0-100 match score)
INVALID_MATCH_THRESHOLD=25
REVIEW_MATCH_THRESHOLD=60

# Field confidence threshold (0-1) below which a verified field is still
# flagged review_required
LOW_CONFIDENCE_THRESHOLD=0.70
