# Copy this file to `.env` in the backend/ directory and fill in your key.
# If ANTHROPIC_API_KEY is left blank, the AI review pipeline automatically runs
# on its deterministic rule-based fallback path instead of calling Claude —
# the demo works either way, but with Claude configured you get the live
# tool-calling orchestration and the AI-written rationale.

ANTHROPIC_API_KEY=

# Model used for both the planner (tool-calling) and rationale-writer calls.
CLAUDE_MODEL=claude-sonnet-5

# Comma-separated list of origins allowed to call this API (the Angular dev
# server runs on 4200 by default).
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
